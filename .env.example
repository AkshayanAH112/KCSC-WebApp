# MongoDB connection string (Atlas or local). Shared with the mobile app via this API.
MONGODB_URI=

# Secret used to sign the admin JWT. Use a long random string in production.
JWT_SECRET=

# DigitalOcean Spaces — stores every image attached to a news/blog post,
# member photo, or gallery entry. Create a Space + API key at
# https://cloud.digitalocean.com/spaces
DO_SPACES_ENDPOINT=      # e.g. https://sfo3.digitaloceanspaces.com (regional, not bucket-specific)
DO_SPACES_REGION=        # e.g. sfo3
DO_SPACES_BUCKET=        # e.g. kcsc
DO_SPACES_KEY=           # Spaces access key ID
DO_SPACES_SECRET=        # Spaces secret access key
DO_SPACES_CDN_ENDPOINT=  # optional — a Spaces CDN endpoint, used for the public url if set

# Optional: extra origins allowed to call this API (comma separated),
# e.g. the public landing page's domain. /api/* already sends
# Access-Control-Allow-Origin: * via next.config.ts.
MOBILE_ALLOWED_ORIGINS=
